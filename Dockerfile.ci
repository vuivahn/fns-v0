# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim

WORKDIR /app

# Keep the test process unprivileged. This image exposes no network ports and
# accepts no credentials or runtime secrets.
RUN groupadd --gid 10001 app \
  && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY --chown=app:app package.json package-lock.json ./
USER app
RUN npm ci

COPY --chown=app:app . ./
ENV CI=true

CMD ["npm", "run", "test:strict"]
