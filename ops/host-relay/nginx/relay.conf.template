limit_req_zone $binary_remote_addr zone=relay_read:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=relay_publication:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=relay_connections:10m;

log_format fns_relay '$remote_addr $request_method $status $body_bytes_sent $request_time';

server {
  listen 80;
  server_name ${FNS_RELAY_DOMAIN};
  server_tokens off;
  access_log /dev/stdout fns_relay;
  error_log /dev/stderr warn;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/acme;
    default_type text/plain;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${FNS_RELAY_DOMAIN};
  server_tokens off;

  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  access_log /dev/stdout fns_relay;
  error_log /dev/stderr warn;
  client_max_body_size 256k;
  limit_conn relay_connections 20;

  location = /healthz {
    return 404;
  }

  location = /readyz {
    return 404;
  }

  location = /v1/publications {
    limit_req zone=relay_publication burst=10 nodelay;
    proxy_pass http://relay:8080;
    proxy_http_version 1.1;
    proxy_read_timeout 35s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
  }

  location / {
    limit_req zone=relay_read burst=50 nodelay;
    proxy_pass http://relay:8080;
    proxy_http_version 1.1;
    proxy_read_timeout 35s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
  }
}
