#
# Tailscale Funnel terminates public TLS and sends PROXY protocol v2 to this
# loopback-only listener. Do not publish this listener beyond localhost and do
# not replace $proxy_protocol_addr with an untrusted X-Forwarded-For value.
limit_req_zone $proxy_protocol_addr zone=relay_read:10m rate=20r/s;
limit_req_zone $proxy_protocol_addr zone=relay_publication:10m rate=2r/s;
limit_conn_zone $proxy_protocol_addr zone=relay_connections:10m;

log_format fns_relay '$proxy_protocol_addr $request_method $status $body_bytes_sent $request_time';

server {
  listen 8080 proxy_protocol;
  server_name _;
  server_tokens off;
  access_log /dev/stdout fns_relay;
  error_log /dev/stderr warn;
  client_max_body_size 256k;
  limit_conn relay_connections 20;

  location = /healthz {
    return 404;
  }

  location = /readyz {
    return 404;
  }

  # Static FNS content served directly by the edge (not proxied to Relay):
  # alice's page and the service-descriptor sidecar. Read-only bind mount
  # -> /srv/fns-static (see FNS_RELAY_STATIC_DIR in compose.funnel.yaml).
  location = /alice {
    return 301 /alice/;
  }

  location /alice/ {
    alias /srv/fns-static/alice/;
    index index.html;
    default_type text/html;
    autoindex off;
  }

  location /fns-descriptors/ {
    alias /srv/fns-static/fns-descriptors/;
    default_type application/json;
    autoindex off;
  }

  location = /v1/publications {
    limit_req zone=relay_publication burst=10 nodelay;
    proxy_pass http://relay:8080;
    proxy_http_version 1.1;
    proxy_read_timeout 35s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_protocol_addr;
    proxy_set_header X-Real-IP $proxy_protocol_addr;
    proxy_set_header Authorization $http_authorization;
  }

  location / {
    limit_req zone=relay_read burst=50 nodelay;
    proxy_pass http://relay:8080;
    proxy_http_version 1.1;
    proxy_read_timeout 35s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_protocol_addr;
    proxy_set_header X-Real-IP $proxy_protocol_addr;
    proxy_set_header Authorization $http_authorization;
  }
}
