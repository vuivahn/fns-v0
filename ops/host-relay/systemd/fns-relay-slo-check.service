[Unit]
Description=FNS Relay recovery-objective and readiness check
# Do not tie this to the direct-TLS service. Funnel and direct-TLS profiles
# share the same Relay container name but must never be started together.
After=docker.service
Requires=docker.service
OnFailure=fns-relay-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/fns-relay/relay.env
ExecStart=/usr/bin/env bash /opt/fns-relay/bin/check-slos.sh
TimeoutStartSec=1min
