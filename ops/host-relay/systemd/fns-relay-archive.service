[Unit]
Description=FNS Relay verified logical archive
# This job is intentionally profile-neutral: the same Relay data can be served
# by either fns-relay.service (direct TLS) or fns-relay-funnel.service. Do not
# make it pull in one profile while the other owns the data paths.
After=docker.service
Requires=docker.service
OnFailure=fns-relay-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/fns-relay/relay.env
ExecStart=/usr/bin/env bash /opt/fns-relay/bin/archive.sh
TimeoutStartSec=10min
