[Unit]
Description=FNS Relay isolated off-provider restore drill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/fns-relay/relay.env
ExecStart=/usr/bin/env bash /opt/fns-relay/bin/restore-drill.sh
TimeoutStartSec=4h
