[Unit]
Description=FNS Relay independent off-provider archive copy
Wants=network-online.target
After=network-online.target
OnFailure=fns-relay-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/fns-relay/relay.env
ExecStart=/usr/bin/env bash /opt/fns-relay/bin/off-provider-copy.sh
TimeoutStartSec=4h
