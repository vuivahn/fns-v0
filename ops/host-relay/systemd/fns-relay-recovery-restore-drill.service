[Unit]
Description=FNS Relay independent recovery-host restore/read drill
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service
OnFailure=fns-relay-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/fns-relay/recovery.env
ExecStart=/usr/bin/env bash /opt/fns-relay/bin/restore-drill.sh
TimeoutStartSec=4h
