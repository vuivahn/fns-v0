[Unit]
Description=FNS public Relay local-reference service
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
Conflicts=fns-relay-funnel.service
OnFailure=fns-relay-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/fns-relay/relay.env
WorkingDirectory=/opt/fns-relay
ExecStartPre=/usr/bin/env bash /opt/fns-relay/bin/assert-active-profile.sh direct
ExecStartPre=/usr/bin/env bash /opt/fns-relay/bin/verify-image.sh
ExecStart=/usr/bin/docker compose --project-name fns-relay --env-file /etc/fns-relay/relay.env --file /opt/fns-relay/compose.yaml --profile edge up --detach --remove-orphans
ExecStop=/usr/bin/docker compose --project-name fns-relay --env-file /etc/fns-relay/relay.env --file /opt/fns-relay/compose.yaml stop --timeout 15
TimeoutStartSec=2min
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
