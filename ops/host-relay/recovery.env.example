# Copy this only to an independently located recovery host as
# /etc/fns-relay/recovery.env. It has no production Relay data paths or secrets.

# Use a root-only rclone config with a recovery-specific, read-only credential
# for the same encrypted remote used by the primary host.
FNS_RELAY_RCLONE_CONFIG=/etc/fns-relay/off-provider/rclone-recovery.conf
FNS_RELAY_OFF_PROVIDER_REMOTE=replace-with-crypt-remote:fns-relay

# Fresh restore runs and their append-only local evidence stay on the recovery
# host, not on the primary Relay VM/home server.
FNS_RELAY_EVIDENCE_DIR=/var/lib/fns-relay-recovery/evidence
FNS_RELAY_DRILL_ROOT=/var/lib/fns-relay-recovery/restore-drills

# Public transport checks use a source-offer read plus a durable anonymous
# object selected by the operator. This must be reachable without Tailscale.
FNS_RELAY_PUBLIC_BASE_URL=https://replace-with-public-relay.example:8443
FNS_RELAY_PUBLIC_PROBE_OBJECT_ID=fns:obj:sha256:replace-with-43-base64url-characters

# An operator-owned HTTPS receiver. Keep its URL and optional bearer token in
# separate root-only files, never in this environment file or source control.
FNS_RELAY_ALERT_WEBHOOK_URL_FILE=/etc/fns-relay/alerts/webhook-url
# FNS_RELAY_ALERT_WEBHOOK_BEARER_TOKEN_FILE=/etc/fns-relay/alerts/webhook-bearer-token
FNS_RELAY_ALERT_TIMEOUT_SECONDS=15
